# Clerk Authentication
# Get these from your Clerk Dashboard (https://dashboard.clerk.com/)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Clerk URLs - Update these to match your domain
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Privacy Controls Configuration
# Secret key for generating secure download tokens
DOWNLOAD_TOKEN_SECRET=your-secure-random-secret-key-here

# Email Configuration for Data Export Delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@yourdomain.com

# Clerk Webhook Secret (for syncing user data to Supabase)
# Get this from Clerk Dashboard > Webhooks > Add Endpoint
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Supabase Configuration
# Get these from your Supabase Dashboard (https://app.supabase.com/)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Database URL (for migrations)
DATABASE_URL=postgresql://postgres:your_password@db.your-project-id.supabase.co:5432/postgres

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="ShopTheBarber"

# Email Configuration (Optional - for custom email templates)
# If using a custom email service like SendGrid, Mailgun, etc.
EMAIL_FROM=noreply@shopthebarber.com
EMAIL_REPLY_TO=support@shopthebarber.com

# Analytics (Optional)
# Add your analytics service keys here
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_token

# Error Monitoring (Optional)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# File Upload (Optional)
# If using cloud storage for file uploads
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_S3_BUCKET=your-s3-bucket-name
# AWS_REGION=us-east-1

# Rate Limiting (Optional)
# UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_redis_token

# Development/Testing
NODE_ENV=development

# Security
# Generate a random secret for JWT signing (if needed for custom auth flows)
# JWT_SECRET=your_super_secret_jwt_key_here

# OAuth Provider Secrets
# Google OAuth - Get from Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Facebook OAuth - Get from Facebook Developers
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here

# Apple OAuth - Get from Apple Developer
APPLE_CLIENT_ID=your_apple_client_id_here
APPLE_TEAM_ID=your_apple_team_id_here
APPLE_KEY_ID=your_apple_key_id_here
APPLE_PRIVATE_KEY=your_apple_private_key_here

# Feature Flags (Optional)
# Enable/disable features in different environments
NEXT_PUBLIC_ENABLE_SOCIAL_LOGIN=true
NEXT_PUBLIC_ENABLE_MFA=true
NEXT_PUBLIC_ENABLE_EMAIL_VERIFICATION=true

# Logging
# LOG_LEVEL=info

# API Rate Limits
# API_RATE_LIMIT_REQUESTS=100
# API_RATE_LIMIT_WINDOW=900000

# Session Configuration
# SESSION_TIMEOUT=3600000

# Webhook URLs (for production)
# WEBHOOK_URL=https://your-domain.com/api/webhooks/clerk

# Service Catalog Configuration
# Maximum file size for service images (in bytes, default: 5MB)
SERVICE_IMAGES_MAX_SIZE=5242880

# Allowed image types for service uploads
SERVICE_IMAGES_ALLOWED_TYPES=image/jpeg,image/png,image/webp

# Search debounce delay in milliseconds
SERVICE_SEARCH_DEBOUNCE_MS=300

# Default page size for service catalog
SERVICE_CATALOG_PAGE_SIZE=12

# Maximum page size allowed for service catalog
SERVICE_CATALOG_MAX_PAGE_SIZE=50

# Service video upload configuration (Optional)
# Maximum file size for service videos (in bytes, default: 50MB)
SERVICE_VIDEOS_MAX_SIZE=52428800

# Allowed video types for service uploads
SERVICE_VIDEOS_ALLOWED_TYPES=video/mp4,video/webm,video/mov

# CDN Configuration for service media (Optional)
# CDN_BASE_URL=https://your-cdn-domain.com
# CDN_SERVICE_IMAGES_PATH=/service-images
# CDN_SERVICE_VIDEOS_PATH=/service-videos

# Service search configuration
# Enable full-text search (requires PostgreSQL with proper indexes)
ENABLE_FULLTEXT_SEARCH=true

# Cache configuration for service data (Optional)
# REDIS_URL=redis://localhost:6379
# SERVICE_CACHE_TTL=300

# Image optimization settings (Optional)
# ENABLE_IMAGE_OPTIMIZATION=true
# IMAGE_QUALITY=80
# IMAGE_FORMATS=webp,jpeg

# Service booking integration
# Enable automatic service selection in booking flow
ENABLE_SERVICE_BOOKING_INTEGRATION=true

# Service analytics (Optional)
# Track service views and interactions
ENABLE_SERVICE_ANALYTICS=true

# Geolocation and Mapping Services
# Required for Home Visit Features - Address validation, geocoding, and travel calculations

# Google Maps API Configuration
# Get API key from Google Cloud Console (https://console.cloud.google.com/)
# Enable: Geocoding API, Distance Matrix API, Maps JavaScript API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Mapbox API Configuration (Alternative to Google Maps)
# Get access token from Mapbox (https://account.mapbox.com/access-tokens/)
# Provides geocoding and directions services
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# Geocoding Provider Selection
# Choose primary provider: 'google' or 'mapbox'
# The system will fallback to the other provider if primary fails
NEXT_PUBLIC_GEOCODING_PROVIDER=google

# Home Visit Configuration
# Default travel time estimation (minutes per km) when APIs are unavailable
DEFAULT_TRAVEL_TIME_PER_KM=2

# Maximum allowed travel distance for home visits (km)
MAX_HOME_VISIT_DISTANCE=50

# Address validation settings
ENABLE_ADDRESS_AUTOCOMPLETE=true
ADDRESS_VALIDATION_STRICT=true

# For location-based service filtering
ENABLE_GEOLOCATION_SEARCH=true

# Content moderation (Optional)
# For service descriptions and reviews
# CONTENT_MODERATION_API_KEY=your_moderation_api_key
# ENABLE_CONTENT_MODERATION=true

# Real-Time Availability Configuration
# Supabase Realtime is enabled by default for authenticated users
# These settings control the real-time booking behavior

# Slot reservation timeout (in minutes)
# How long a time slot is reserved before it expires
SLOT_RESERVATION_TIMEOUT_MINUTES=10

# Real-time subscription channels
# Enable real-time updates for availability calendar
ENABLE_REALTIME_AVAILABILITY=true

# Polling fallback configuration (if realtime fails)
# Fallback to polling every X seconds if realtime connection is lost
AVAILABILITY_POLLING_INTERVAL_SECONDS=30

# Maximum concurrent reservations per user
# Prevent users from reserving too many slots simultaneously
MAX_CONCURRENT_RESERVATIONS=3

# Booking conflict resolution
# How to handle double-booking attempts
# Options: 'reject', 'queue', 'notify'
BOOKING_CONFLICT_STRATEGY=reject

# Real-time notification settings
# Enable push notifications for booking updates
ENABLE_BOOKING_NOTIFICATIONS=true

# Cleanup job configuration
# How often to clean up expired reservations (in minutes)
CLEANUP_EXPIRED_RESERVATIONS_INTERVAL=5

# Database connection pool settings for high concurrency
# Adjust these based on your expected concurrent booking load
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000

# Rate limiting for booking endpoints
# Prevent abuse of the booking system
BOOKING_RATE_LIMIT_REQUESTS=10
BOOKING_RATE_LIMIT_WINDOW=60000

# Testing configuration
# Settings for running tests
TEST_DATABASE_URL=postgresql://test:test@localhost:5432/test_lebarbier
TEST_SUPABASE_URL=https://test.supabase.co
TEST_SUPABASE_ANON_KEY=test-anon-key
TEST_CLERK_PUBLISHABLE_KEY=test-clerk-key